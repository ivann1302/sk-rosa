---
const { kind } = Astro.props;

const icons = {
  request: "/assets/images/rental-process/request.webp",
  estimate: "/assets/images/rental-process/calculation.webp",
  handover: "/assets/images/rental-process/handover.webp",
  return: "/assets/images/rental-process/return.webp",
};
---

<img
  class="rental-step__icon"
  src={icons[kind]}
  alt=""
  width="512"
  height="512"
  loading="lazy"
  decoding="async"
/>
