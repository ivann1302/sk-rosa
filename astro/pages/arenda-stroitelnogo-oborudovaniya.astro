---
import BaseLayout from "../components/BaseLayout.astro";
import EquipmentIllustration from "../components/rental/EquipmentIllustration.astro";
import RentalRatings from "../components/rental/RentalRatings.astro";
import RentalStepIcon from "../components/rental/RentalStepIcon.astro";
import ContactRequest from "../components/service/ContactRequest.astro";
import FaqSection from "../components/service/FaqSection.astro";
import ServiceRuntime from "../components/service/ServiceRuntime.astro";
import {
  equipmentRentalPage,
  rentalFaq,
  rentalFaqDescription,
  rentalContentLastModified,
  rentalEquipment,
} from "../data/equipment-rental.js";
import {
  rentalCatalogStats,
  rentalGroupPages,
} from "../data/equipment-rental-catalog.js";
import { breadcrumbJsonLd, businessId } from "../lib/seo.js";

const { seo } = equipmentRentalPage;
const catalogPriceFrom = Math.min(...rentalEquipment.map(item => item.priceFrom));
const rentalCatalogServiceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${seo.canonical}#service`,
  url: seo.canonical,
  name: "Аренда строительного оборудования в Москве и Долгопрудном",
  description: seo.description,
  serviceType: "Аренда и прокат строительного оборудования",
  provider: { "@id": businessId },
  areaServed: [
    { "@type": "City", name: "Москва" },
    { "@type": "City", name: "Долгопрудный" },
    { "@type": "AdministrativeArea", name: "Московская область" },
  ],
  availableChannel: {
    "@type": "ServiceChannel",
    serviceUrl: seo.canonical,
    availableLanguage: "ru",
    servicePhone: {
      "@type": "ContactPoint",
      telephone: "+79851354991",
      contactType: "rental service",
      availableLanguage: "ru",
    },
  },
  hasOfferCatalog: { "@id": `${seo.canonical}#catalog` },
  offers: {
    "@type": "AggregateOffer",
    lowPrice: String(catalogPriceFrom),
    priceCurrency: "RUB",
    offerCount: rentalEquipment.length,
    url: seo.canonical,
  },
};
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": ["ItemList", "OfferCatalog"],
  "@id": `${seo.canonical}#catalog`,
  name: "Строительное оборудование в аренду и напрокат",
  numberOfItems: rentalEquipment.length,
  itemListElement: rentalEquipment.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: item.seo.canonical,
    name: item.name,
  })),
};
const directoryItemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${seo.canonical}#directions`,
  name: "Разделы каталога оборудования в аренду",
  numberOfItems: rentalGroupPages.length,
  itemListElement: rentalGroupPages.map((group, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: group.canonical,
    name: group.heading,
  })),
};
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: rentalFaq.map(item => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  ogTitle="Аренда оборудования — Москва и Долгопрудный | ROSA"
  ogDescription={seo.description}
  ogImage="https://sk-rosa.ru/assets/images/rental-preview/rental-service-hero.webp"
  ogImageWidth="1536"
  ogImageHeight="1024"
  ogImageAlt="Аренда строительного оборудования ROSA"
  bodyClass="rental-page"
  mainEntityId={`${seo.canonical}#service`}
  dateModified={rentalContentLastModified}
  jsonLd={[
    rentalCatalogServiceJsonLd,
    itemListJsonLd,
    directoryItemListJsonLd,
    faqJsonLd,
    breadcrumbJsonLd([
      { name: "Главная", url: "https://sk-rosa.ru/" },
      { name: "Аренда оборудования", url: seo.canonical },
    ]),
  ]}
>
  <main>
    <section class="rental-hero">
      <div class="rental-container rental-hero__grid">
        <div class="rental-hero__content">
          <RentalRatings />
          <h1>Аренда строительного оборудования в Москве и Долгопрудном</h1>
          <p class="rental-hero__lead">
            Берите профессиональную технику на нужный срок без затрат на покупку, хранение и
            обслуживание. Работаем с частными заказчиками, ИП и организациями.
          </p>
          <div class="rental-hero__actions">
            <a class="rental-button rental-button--light" href="#directions">Выбрать оборудование</a>
            <a class="rental-button rental-button--phone" href="tel:+79851354991">+7 (985) 135-49-91</a>
          </div>
          <ul class="rental-hero__facts" aria-label="Условия аренды">
            <li>от 1 часа</li>
            <li>доставка по Москве и МО</li>
            <li>договор и акт</li>
          </ul>
        </div>
        <div class="rental-hero__media">
          <img
            src="/assets/images/rental-preview/rental-service-hero.webp"
            alt="Профессиональный электроинструмент для аренды"
            width="1536"
            height="1024"
            decoding="async"
            fetchpriority="high"
          />
          <div
            class="rental-hero__media-stat"
            aria-label={`${rentalCatalogStats.catalogItemCount} позиций в каталоге`}
          >
            <strong>{rentalCatalogStats.catalogItemCount}</strong>
            <span>позиций<br />в каталоге</span>
          </div>
          <div class="rental-hero__media-caption">
            <p>Оборудование в аренду по гибким ценам</p>
            <span>С доставкой или самовывозом · Москва и Долгопрудный</span>
          </div>
        </div>
      </div>
    </section>

    <section class="rental-seo-intro" aria-labelledby="rental-seo-intro-title">
      <div class="rental-container">
        <div class="rental-seo-intro__content">
          <div class="rental-seo-intro__heading">
            <p class="rental-seo-intro__eyebrow">Москва и Долгопрудный</p>
            <h2 id="rental-seo-intro-title">
              Аренда и прокат строительного оборудования
            </h2>
          </div>
          <div class="rental-seo-intro__text">
            <p>
              ROSA сдаёт оборудование в аренду для ремонта, строительства, монтажа и обслуживания
              объектов в Москве и Долгопрудном. В каталоге — более 300 позиций: строительное
              оборудование, электро- и ручной инструмент, сантехнический инструмент и другая
              техника для бетонных, отделочных, демонтажных и инженерных работ.
            </p>
            <p>
              Подберём оборудование под задачу и срок — от одного часа до длительной аренды,
              заранее рассчитаем стоимость и комплектацию. Предлагаем гибкие цены, доставку по
              Москве и Московской области и самовывоз из Долгопрудного. Работаем с частными
              клиентами, мастерами, ИП и организациями по договору.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="rental-section" id="directions">
      <div class="rental-container">
        <div class="rental-section__heading">
          <h2>Каталог</h2>
        </div>
        <nav class="rental-directory" aria-label="Разделы каталога аренды">
          {
            rentalGroupPages.map(group => (
              <a class="rental-directory__link" href={new URL(group.canonical).pathname}>
                <strong class="rental-directory__title">{group.name}</strong>
                <span class="rental-directory__arrow" aria-hidden="true">→</span>
              </a>
            ))
          }
        </nav>
      </div>
    </section>

    <section class="rental-section rental-section--light" id="catalog">
      <div class="rental-container">
        <div class="rental-section__heading">
          <h2>Популярные позиции в аренду</h2>
          <p>
            Оборудование и инструменты, которые чаще всего выбирают для строительных, ремонтных и
            монтажных работ.
          </p>
        </div>
        <div class="rental-catalog">
          {
            rentalEquipment.map(item => (
              <article
                class:list={["rental-card", { "rental-card--photo": item.previewImage }]}
                data-rental-card
              >
                <div class="rental-card__visual" aria-hidden="true">
                  {
                    item.previewImage ? (
                      <img
                        class="rental-card__image"
                        src={item.previewImage}
                        alt=""
                        width={item.previewImageSize?.[0] ?? 1536}
                        height={item.previewImageSize?.[1] ?? 1024}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <EquipmentIllustration kind={item.visualKind} variant="card" />
                    )
                  }
                </div>
                <div class="rental-card__body">
                  <h3><a href={`/${item.slug}`}>{item.shortName}</a></h3>
                  <div class="rental-card__reveal">
                    <div class="rental-card__reveal-inner">
                      <p class="rental-card__summary">{item.summary}</p>
                      <div class="rental-card__footer">
                        <strong>{item.priceLabel}</strong>
                        <span class="rental-card__more">Подробнее <span aria-hidden="true">→</span></span>
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="rental-section rental-process">
      <div class="rental-container">
        <div class="rental-section__heading">
          <h2>От заявки до возврата — четыре шага</h2>
        </div>
        <ol class="rental-steps">
          <li>
            <RentalStepIcon kind="request" />
            <span class="rental-step__number">01</span>
            <strong>Заявка</strong>
            <p>Назовите технику, даты, объём работ и район доставки.</p>
          </li>
          <li>
            <RentalStepIcon kind="estimate" />
            <span class="rental-step__number">02</span>
            <strong>Расчёт</strong>
            <p>Проверим наличие и согласуем срок, доставку и полную стоимость.</p>
          </li>
          <li>
            <RentalStepIcon kind="handover" />
            <span class="rental-step__number">03</span>
            <strong>Передача</strong>
            <p>Подпишем договор и акт, проверим комплектность оборудования.</p>
          </li>
          <li>
            <RentalStepIcon kind="return" />
            <span class="rental-step__number">04</span>
            <strong>Возврат</strong>
            <p>Проверим исправность и вернём залог, если он предусмотрен.</p>
          </li>
        </ol>
      </div>
    </section>

    <ContactRequest
      title="Подобрать оборудование под вашу задачу"
      subtitle="Оставьте номер телефона. Уточним объём и условия работ, проверим свободные даты и рассчитаем аренду с доставкой."
      features={["Работаем с физлицами, ИП и организациями", "Можно забронировать и продлить аренду", "Ежедневно с 10:00 до 20:00"]}
      formSource="Аренда строительного оборудования"
      comments="Заявка со страницы аренды строительного оборудования"
      propertyType="equipment-rental"
      variant="rental"
    />

    <FaqSection
      title="Частые вопросы об аренде оборудования"
      description={rentalFaqDescription}
      items={rentalFaq}
    />
  </main>
  <script>
    const rentalCards = Array.from(document.querySelectorAll("[data-rental-card]"));

    if (!("IntersectionObserver" in window)) {
      rentalCards.forEach(card => card.classList.add("is-in-view"));
    } else {
      const rentalCardObserver = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-in-view");
              rentalCardObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.35, rootMargin: "0px 0px -8% 0px" }
      );

      rentalCards.forEach(card => rentalCardObserver.observe(card));
    }
  </script>
  <ServiceRuntime
    slot="runtime"
    pricingScript={false}
    callBannerComments="Заявка со страницы аренды строительного оборудования"
    callBannerSource="Баннер — аренда строительного оборудования"
  />
</BaseLayout>
